#!/usr/bin/python3
"""Resolve artwork for Arcade games (local caches + optional SteamGridDB)."""

from __future__ import annotations

import argparse
import json
import sys
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from arcade.config import load_config
from arcade.paths import arcade_cache_dir, expand_user, library_path


def _sgdb_key(cfg) -> str | None:
    key_file = cfg.art.get("steamgriddb_key_file")
    if not key_file:
        return None
    path = expand_user(str(key_file))
    if path.is_file():
        return path.read_text(encoding="utf-8").strip() or None
    return None


def _fetch_sgdb(kind: str, appid: int, key: str, dest: Path, dimensions: str) -> str | None:
    url = (
        f"https://www.steamgriddb.com/api/v2/{kind}/steam/{appid}"
        f"?dimensions={dimensions}&types=static"
    )
    req = urllib.request.Request(url, headers={"Authorization": f"Bearer {key}"})
    try:
        with urllib.request.urlopen(req, timeout=15) as resp:
            data = json.loads(resp.read().decode("utf-8"))
    except (urllib.error.URLError, TimeoutError, json.JSONDecodeError):
        return None
    rows = (data.get("data") or []) if isinstance(data, dict) else []
    if not rows:
        return None
    image_url = rows[0].get("url")
    if not image_url:
        return None
    dest.parent.mkdir(parents=True, exist_ok=True)
    try:
        with urllib.request.urlopen(image_url, timeout=30) as img:
            dest.write_bytes(img.read())
    except (urllib.error.URLError, TimeoutError, OSError):
        return None
    return dest.as_uri()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Fetch missing Arcade artwork")
    parser.add_argument("ids", nargs="*", help="Game ids to resolve (default: all missing covers)")
    parser.add_argument("--plugin-dir", type=Path, default=ROOT)
    parser.add_argument("--limit", type=int, default=20)
    args = parser.parse_args(argv)

    cfg = load_config(plugin_dir=args.plugin_dir)
    lib_path = library_path()
    if not lib_path.is_file():
        print(json.dumps({"updated": 0, "error": "no library"}))
        return 1
    data = json.loads(lib_path.read_text(encoding="utf-8"))
    key = _sgdb_key(cfg)
    updated = 0
    results = []
    for game in data.get("games") or []:
        if args.ids and game["id"] not in args.ids:
            continue
        art = game.setdefault("art", {})
        appid = game.get("steamAppId")
        if not appid or not key:
            continue
        dest_dir = arcade_cache_dir() / "art" / game["id"].replace(":", "_")
        changed = {}
        if not art.get("cover"):
            uri = _fetch_sgdb("grids", int(appid), key, dest_dir / "cover.jpg", "600x900")
            if uri:
                art["cover"] = uri
                changed["cover"] = uri
                updated += 1
        if not art.get("hero"):
            uri = _fetch_sgdb("heroes", int(appid), key, dest_dir / "hero.jpg", "1920x620")
            if uri:
                art["hero"] = uri
                changed["hero"] = uri
                updated += 1
        if changed:
            results.append({"id": game["id"], **changed})
        if updated >= args.limit:
            break
    if updated:
        tmp = lib_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        tmp.replace(lib_path)
    print(json.dumps({"updated": updated, "results": results}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
