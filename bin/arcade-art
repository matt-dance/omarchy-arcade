#!/usr/bin/python3
"""Resolve artwork for Arcade games (local caches + optional SteamGridDB)."""

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
if str(ROOT) not in sys.path:
    sys.path.insert(0, str(ROOT))

from arcade.art import fetch_sgdb_image, search_sgdb_game_id
from arcade.config import load_config
from arcade.meta.keys import load_keys
from arcade.paths import arcade_cache_dir, expand_user, library_path


def _sgdb_key(cfg) -> str | None:
    keys = load_keys()
    if keys.steamgriddb_api_key:
        return keys.steamgriddb_api_key
    # Legacy single-line file still accepted for arcade-art.
    key_file = cfg.art.get("steamgriddb_key_file")
    if not key_file:
        return None
    path = expand_user(str(key_file))
    if path.is_file():
        return path.read_text(encoding="utf-8").strip() or None
    return None


def _lookup(game: dict) -> tuple[str, int] | None:
    appid = game.get("steamAppId")
    if appid:
        try:
            return ("steam", int(appid))
        except (TypeError, ValueError):
            pass
    return None


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description="Fetch missing Arcade artwork")
    parser.add_argument("ids", nargs="*", help="Game ids to resolve (default: all missing covers)")
    parser.add_argument("--plugin-dir", type=Path, default=ROOT)
    parser.add_argument("--limit", type=int, default=20)
    args = parser.parse_args(argv)

    cfg = load_config(plugin_dir=args.plugin_dir)
    lib_path = library_path()
    if not lib_path.is_file():
        print(json.dumps({"updated": 0, "error": "no library"}))
        return 1
    data = json.loads(lib_path.read_text(encoding="utf-8"))
    key = _sgdb_key(cfg)
    if not key:
        print(json.dumps({"updated": 0, "results": [], "reason": "no steamgriddb key"}))
        return 0
    updated = 0
    results = []
    for game in data.get("games") or []:
        if args.ids and game["id"] not in args.ids:
            continue
        art = game.setdefault("art", {})
        icon_only = bool(art.get("iconOnly"))
        need_cover = (not art.get("cover")) or icon_only
        need_hero = not art.get("hero")
        if not need_cover and not need_hero:
            continue
        lookup = _lookup(game)
        if lookup is None:
            sgdb_id = search_sgdb_game_id(str(game.get("title") or ""), key)
            if sgdb_id is not None:
                lookup = ("game", sgdb_id)
        if lookup is None:
            continue
        dest_dir = arcade_cache_dir() / "art" / game["id"].replace(":", "_")
        changed = {}
        if need_cover:
            uri = fetch_sgdb_image("grids", lookup, key, dest_dir / "cover.jpg", "600x900")
            if uri:
                art["cover"] = uri
                art.pop("iconOnly", None)
                changed["cover"] = uri
                updated += 1
        if need_hero:
            uri = fetch_sgdb_image("heroes", lookup, key, dest_dir / "hero.jpg", "1920x620")
            if uri:
                art["hero"] = uri
                changed["hero"] = uri
                updated += 1
        if changed:
            results.append({"id": game["id"], "lookup": list(lookup), **changed})
        if updated >= args.limit:
            break
    if updated:
        tmp = lib_path.with_suffix(".tmp")
        tmp.write_text(json.dumps(data, indent=2, ensure_ascii=False) + "\n", encoding="utf-8")
        tmp.replace(lib_path)
    print(json.dumps({"updated": updated, "results": results}))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
